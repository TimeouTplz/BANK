@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center

participant "Источник\n(ИБ, И32)" as Source
participant "Диспетчер\nПостановки" as PlaceDisp
participant "Буфер\n(Д1031)" as Buffer
participant "Отказ" as Reject

title Сценарий 2: Переполнение буфера (Д1004 - выбивание последней заявки)

Source -> PlaceDisp: Новая заявка (транзакция)

PlaceDisp -> Buffer: Проверить наличие свободного места

alt Буфер переполнен
    Buffer --> PlaceDisp: Свободных мест нет
    
    note right of PlaceDisp: Д1004: Выбиваем последнюю\nпоступившую в буфер заявку\n(самую "молодую" в очереди)
    
    PlaceDisp -> Buffer: removeLastRequest()
    Buffer --> PlaceDisp: Выбитая заявка
    
    PlaceDisp -> Reject: Заявка аннулирована (отказ)
    note right of Reject: Счётчик отказов +1\nдля источника выбитой заявки
    
    PlaceDisp -> Buffer: addRequest(Новая заявка)
    Buffer --> PlaceDisp: Новая заявка заняла освободившееся место

else Место есть
    Buffer --> PlaceDisp: Место найдено (Д1031 - по кольцу)
    PlaceDisp -> Buffer: addRequest(Новая заявка)
    Buffer --> PlaceDisp: Заявка добавлена
end

@enduml
